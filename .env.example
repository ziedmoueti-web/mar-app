# BADEL server configuration
# Copy to .env and adjust. Nothing here is secret in the demo build.

# Port for the API server
PORT=8787

# ------------------------------------------------------------------
# Backend mode
#   local  – built-in relational backend (SQLite via node:sqlite).
#            This is the fully working demo backend with a real
#            relational schema, sessions, uploads and business rules.
#   supabase – requires SUPABASE_URL / SUPABASE_ANON_KEY and a
#            Supabase project provisioned from supabase/schema.sql.
#            (Backend adapter ships with the SQL + RLS in /supabase.)
# ------------------------------------------------------------------
BACKEND=local

# Supabase (used only when BACKEND=supabase)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. NEVER expose this key in frontend code.
SUPABASE_SERVICE_ROLE_KEY=

# Demo credentials shown on the login screen
DEMO_EMAIL=demo@badel.tn
DEMO_PASSWORD=badel-demo
